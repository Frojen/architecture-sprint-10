        <mxCell id="Fr8ohqFJBptWJElNSE4S-99" value="Все данные хранятся в зашифрованном виде (AES-256)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
