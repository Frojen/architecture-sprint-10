        </mxCell>
        <mxCell id="Fr8ohqFJBptWJElNSE4S-102" value="Персональные данные пациентов уничтожаются по запросу пациента или через 1 год после окончания срока действия договора" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
