        </mxCell>
        <mxCell id="Fr8ohqFJBptWJElNSE4S-101" value="Финансовые данные хранятся в течении 6 лет (для налоговой отчетности)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
