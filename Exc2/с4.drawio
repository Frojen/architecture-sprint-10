        <mxCell id="Fr8ohqFJBptWJElNSE4S-103" value="Медицинские данные хранятся в течении 5 лет с момента последнего обращения пациента" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
